# Python
.venv/
__pycache__/
*.pyc

# Model conversion outputs (regenerated by the convert-model build step on
# every build; committing them only causes pull conflicts).
model/model.pte
ai_layer/model/model_pte.h

# CMSIS-Toolbox build outputs
out/
tmp/
RTE/
.cmsis/
*.cbuild-idx.yml
*.cbuild-pack.yml
*.cbuild-mlops.yml
uv2csolution.log
*.update@*
.cmd.jlink
*.cprj

# Compiler-generated dependencies
*.d
# CMSIS Solution drop-ins are source files, despite the directory suffix.
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Kernel module build outputs
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# SDS playback recordings and FVP logs
**/*.p.sds
**/*.p.sds.bak
**/sdsio.log

# Local support-ticket material (logs, screenshots); never part of the example.
support-cases/

# Editor / container config. The FVP run/debug wiring that lives in these
# directories is carried by the Codespaces branch, not by this one.
.vscode/
.devcontainer/
