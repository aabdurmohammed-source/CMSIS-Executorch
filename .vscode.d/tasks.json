{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Python virtual environment",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create AI layer",
            "detail": "Export model/model.py for the NPU in cmsis-executorch-simple.cbuild-mlops.yml and write ai_layer/ (run a CMSIS build or 'cbuild setup' first)",
            "type": "shell",
            "command": "python3",
            "args": ["create_ai_layer.py", "cmsis-executorch-simple.cbuild-mlops.yml"],
            "windows": {
                "command": "python"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
