{
    "version": "0.2.0",
    "configurations": [
        {
            // Generated by the CMSIS Solution extension from its Arm-FVP adapter
            // template, then switched to "manual" because two "target" fields
            // differ from the generated ones and would be lost on regeneration:
            //   "port": ""  +  "serverPortRegExp"  -- with a port set, the debug
            //     adapter connects 0 ms after spawning the model, before the
            //     GDBServer plugin listens; blank port makes it wait for the
            //     "GDBServer: Listening ... port=3333" banner instead.
            //   "portDetectionTimeout" -- the first run on macOS builds the
            //     Docker image (see .vscode/fvp.sh).
            // To re-sync after changing target-type or build-type: set
            // "updateConfiguration" to "auto", run "CMSIS: Update Debug Tasks
            // and Launch Configurations", then re-apply the three fields above
            // and set it back to "manual".
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/cmsis-executorch/SSE-320-U85/Debug/cmsis-executorch.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "${workspaceFolder}/.vscode/fvp.sh",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.so",
                    "-C",
                    "GDBServer.port=3333",
                    "-f",
                    "board/Corstone-320/fvp_config.txt",
                    "--simlimit",
                    "60",
                    "-a",
                    "out/cmsis-executorch/SSE-320-U85/Debug/cmsis-executorch.hex"
                ],
                "port": "",
                "serverPortRegExp": "GDBServer: Listening .*port=([0-9]+)",
                "portDetectionTimeout": 300000
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "Arm-FVP@GDB (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/cmsis-executorch/SSE-320-U85/Debug/cmsis-executorch.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
